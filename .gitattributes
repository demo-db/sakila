# Keep pinned upstream SQL bytes unchanged; each source SHA is checked by the converter.
data-source/sakila-schema.sql whitespace=-blank-at-eol,-blank-at-eof
data-source/sakila-data.sql whitespace=-blank-at-eol,-blank-at-eof
# The generated scripts are LF text whose bytes are pinned by SHA-256: never convert line ends on checkout.
dialect-scripts/** -text
